#!/usr/bin/env bash
# Locate opik-cipx and dispatch on the event arg:
#   session-start | user-prompt-submit | * -> exec `opik-cipx sync` (idempotent
#     daemon bring-up; the arg is otherwise unused, so any unrecognized event
#     falls through to this default, same as before this launcher took an arg)
#   compress -> run `opik-cipx compress` (PostToolUse Bash-output rewrite, opt-in)
#
# Binaries ship inside the plugin tree at bin/opik-cipx-<os>-<arch>/opik-cipx —
# pushed there by the release workflow in the internal source repo — so a
# clean plugin install already has the right binary on disk. PATH /
# ~/.opik-cipx/bin/ are kept as fallbacks for curl-installed setups and
# dev-time overrides.
#
# Search order:
#   1. ${CLAUDE_PLUGIN_ROOT}/bin/opik-cipx-<os>-<arch>/opik-cipx (plugin-shipped)
#   2. opik-cipx on $PATH
#   3. ~/.opik-cipx/bin/opik-cipx
#   4. /usr/local/bin/opik-cipx

set -u

find_bin() {
  if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
    os="$(uname -s | tr '[:upper:]' '[:lower:]')"
    arch="$(uname -m)"
    case "$arch" in
      x86_64|amd64) arch=amd64 ;;
      arm64|aarch64) arch=arm64 ;;
    esac
    shipped="${CLAUDE_PLUGIN_ROOT}/bin/opik-cipx-${os}-${arch}/opik-cipx"
    if [ -x "$shipped" ]; then
      echo "$shipped"
      return 0
    fi
  fi
  if command -v opik-cipx >/dev/null 2>&1; then
    command -v opik-cipx
    return 0
  fi
  for candidate in "$HOME/.opik-cipx/bin/opik-cipx" "/usr/local/bin/opik-cipx"; do
    if [ -x "$candidate" ]; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

case "${1:-}" in
compress)
  # --- Diagnostic log ---------------------------------------------------
  # Under Harbor /logs/agent is host-mounted (-> jobs/<ts>/<trial>/agent/);
  # else fall back to ~/.opik-cipx/logs. Best-effort: a failed write never
  # breaks the hook. Logged BEFORE find_bin so a re-run distinguishes
  # never-fired (no line at all) from fired-but-binary-missing.
  if [ -d /logs/agent ]; then log_dir=/logs/agent; else log_dir="$HOME/.opik-cipx/logs"; fi
  mkdir -p "$log_dir" 2>/dev/null || true
  log_file="$log_dir/compress-hook.log"
  logln() { printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*" >>"$log_file" 2>/dev/null || true; }
  logln "invoked pid=$$ ppid=$PPID plugin_root=${CLAUDE_PLUGIN_ROOT:-unset} cwd=$PWD stdin_tty=$([ -t 0 ] && echo yes || echo no)"

  # Coarse gate: only the master switch, so a fully-disabled setup doesn't
  # spawn the binary on every Bash call. Which specific compress feature(s)
  # actually run (OPIK_CIPX_COMPRESS_GENERIC, and future feature flags) is
  # Go's decision, not shell's — the binary re-checks and requires both.
  truthy() { case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in 1|true|on|yes) return 0;; *) return 1;; esac; }
  if ! truthy "${OPIK_CIPX_COMPRESS:-}"; then
    logln "disabled (OPIK_CIPX_COMPRESS not enabled)"
    exit 0
  fi

  if ! bin="$(find_bin)"; then
    logln "bin-not-found plugin_root=${CLAUDE_PLUGIN_ROOT:-unset}"
    exit 0
  fi
  logln "bin=$bin"

  # Capture-then-emit (not exec) so the result can be logged after the run.
  payload="$(cat)"
  out="$(printf '%s' "$payload" | "$bin" compress)"

  case "$payload" in
  *'"tool_name":"Bash"'* | *'"tool_name": "Bash"'*) tool=Bash ;;
  *) tool=other ;;
  esac
  logln "tool=$tool in=${#payload} out=${#out} rewrote=$([ -n "$out" ] && echo yes || echo no)"

  printf '%s' "$out"
  exit 0
  ;;
*)
  bin="$(find_bin)" || {
    echo "opik-cipx not found. Reinstall the plugin (/plugin install opik-cipx@opik-enterprise) or run: bash <(curl -fsSL https://raw.githubusercontent.com/comet-ml/cost-intelligence-proxy/main/install.sh). opik-cipx is not capturing until it's installed." >&2
    exit 0
  }
  exec "$bin" sync
  ;;
esac
